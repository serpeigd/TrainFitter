# Copy this file to ".env" (without the ".example") and fill in your real keys.
# The real .env is NEVER committed to the repo (it's in .gitignore).

# Optional — only needed for motor="llm" (see agents/routine_agent.py).
ANTHROPIC_API_KEY=

# Optional — only needed for the Notion connector (see
# mcp/notion_connector.py's module docstring for the full setup steps).
# NOTION_DATABASE_ID is the "Clients" database; NOTION_CHECKINS_DATABASE_ID
# is the separate "Check-ins" database (interaction history, joined by
# email — not a Notion relation).
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_CHECKINS_DATABASE_ID=

# Optional — gates the "Approve" button (and, by extension, Notion/Gmail,
# which only unlock after approval) behind a shared password. Leave unset
# for local dev (no gate at all); set it on any public deployment so random
# visitors can't write to your real Notion/Gmail by clicking through the
# demo. See ui/app.py's APPROVAL_PASSWORD.
APP_APPROVAL_PASSWORD=

# Optional — only needed for the client portal's magic links (see
# agents/portal_tokens.py). Any long random string; used to sign portal
# links so a client can't forge or edit one. Rotating this instantly
# invalidates every outstanding link (there's no other way to revoke one
# early — see portal_tokens.py's module docstring).
PORTAL_SECRET_KEY=

# Optional — the deployed app's own URL, used to build a full, clickable
# portal link (agents/portal_tokens.py only returns the token itself).
# Defaults to http://localhost:8501 for local dev; set to your real
# deployment's URL (e.g. https://trainfitter.streamlit.app) wherever the
# portal is actually used for real. See ui/app.py's PORTAL_BASE_URL.
PORTAL_BASE_URL=
